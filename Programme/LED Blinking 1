/*
 * LED on digital pin 13 
 */

 
void setup (){
      pinMode(13,OUTPUT);   // initialize digital pin 13 as an output.
}

void loop() {
    digitalWrite(13,HIGH);   // turn the LED on (HIGH is the voltage level5V)
    delay(1000);   
    digitalWrite(13,LOW);   // turn the LED on (HIGH is the voltage level5V)
    delay(1000);
} 


    
